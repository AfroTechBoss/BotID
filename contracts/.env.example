# Deployment configuration. Copy to .env and fill in; .env is gitignored.
#
#   npx hardhat run scripts/deploy.js --network bohr        # testnet, chain 968
#   npx hardhat run scripts/deploy.js --network botchain    # mainnet, chain 677
#
# Nothing here is needed for `hardhat test` or `hardhat compile`.

# ---------------------------------------------------------------- signing
# The deployer. Funded from https://faucet.botchain.ai on Bohr.
# This account owns the protocol unless OWNER is set below, so on mainnet it should be a key you
# are willing to have hold ownership for as long as it takes to hand over to a multisig.
PRIVATE_KEY=

# ---------------------------------------------------------------- roles
# Protocol owner. Defaults to the deployer.
# Set this to a multisig and every owner-only wiring call is deferred rather than executed — the
# deploy still writes a manifest, with the outstanding calls listed in `pendingOwnerCalls`, and
# the protocol does not work until they are executed from that address. That is the intended
# path for mainnet; on testnet leaving it unset is usually what you want.
# OWNER=

# Receives protocol fees and slash residue. Defaults to the deployer.
# TREASURY=

# ---------------------------------------------------------------- bond token
# REQUIRED on any non-local network — the deploy refuses to invent one.
#
# WBOT, verified live at this address on BOTH chain 968 and chain 677: a WETH9 clone with no
# admin, no mint, no pause, and totalSupply equal to the native BOT it holds. Bond is slashable
# capital, so a token whose supply a permission can conjure would make the protocol's Sybil bound
# a permission rather than a cost — which is why BOT Chain's "USDT" (a MINTER_ROLE contract, not
# Tether) is not a candidate. See docs/frontend-brief.local.md §20.4.
BOND_TOKEN=0xD5452816194a3784dBa983426cCe7c122F4abd30

# Only needed for a token that does not implement decimals(). Every capital parameter below is
# scaled by this, and getting it wrong does not revert — it silently freezes scores and prices
# challenges out of reach. The deploy reads it from the token and refuses to guess.
# BOND_TOKEN_DECIMALS=18

# ---------------------------------------------------------------- capital parameters
# Whole tokens. Scaled by the bond token's decimals at deploy time; the defaults are shown.
# HALF_WEIGHT=100000           # notional at which one execution moves the score halfway
# WEIGHT_CAP=1000000           # cap on a single execution's weight
# MIN_BOND=500                 # minimum bond to register an agent
# GLOBAL_NOTIONAL_CAP=5000000  # protocol-wide open exposure ceiling
# CHALLENGE_BOND=100           # bond required to challenge a delivery

# ---------------------------------------------------------------- input feeds
# Publishers whose quorum signs feed bundles. Comma-separated.
# Without at least one, no input bundle can be attested and no execution can be requested, so
# this is effectively required before the protocol is usable — it is left empty because the
# addresses are an operational decision, not a default.
# PUBLISHERS=
# PUBLISHER_QUORUM=1
# INPUT_MAX_AGE=300            # seconds a feed reading stays fresh

# ---------------------------------------------------------------- tiers
# Addresses allowed to enroll Silver-tier enclave measurements.
# TEE_NOTARIES=

# Gold tier. "false" skips the ZK adapter, its verifier and the model binding entirely.
# Bronze and Silver are unaffected, but challenge escalation then has no court of last resort.
# DEPLOY_GOLD=false

# Reuse an already-deployed ezkl verifier instead of deploying circuits/build/Verifier.sol.
# EZKL_VERIFIER=

# Bind the verifier to a different model than circuits/spec.json describes. The commitment is
# keccak256 of the model name and must match what the agent registered with; the scale bits are
# the circuit's `input_scale`. Both are read from spec.json by default, and guessing either makes
# every honest Gold proof for that model fail closed.
# MODEL_COMMITMENT=
# INPUT_SCALE_BITS=
