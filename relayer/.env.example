# Copy to relayer/.env. Real environment variables take precedence over this file.

RPC_URL=http://127.0.0.1:8545

# Deployment manifest written by contracts/scripts/deploy.js.
MANIFEST=../contracts/deployments/localhost-31337.json

# --- agent -------------------------------------------------------------------
# The operator key. This key can only sign attestations; it cannot move the bond or
# withdraw fees, both of which are the agent owner's. Keep them separate.
AGENT_ID=1
OPERATOR_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# --- Silver tier only --------------------------------------------------------
# Generated inside the enclave; the notary enrols the public key against MEASUREMENT.
# ENCLAVE_KEY=
# MEASUREMENT=

# --- the model ---------------------------------------------------------------
# The agent runs circuits/run.py — the circuit itself — at every tier, not just Gold. A
# hand-written reimplementation that differs in the last digit commits the agent to a number
# it cannot prove when it is challenged, so the two are never allowed to be separate things.
# Build it first: cd circuits && python export_onnx.py && python pipeline.py
# CIRCUITS_DIR=../circuits
# PYTHON=python
#
# Opts into the pure-JS port of the integer reference in src/inference.js. For hosts with no
# Python toolchain. It agrees with the circuit today because pipeline.py checks that it does;
# it is a liability the moment spec.json changes without it.
# MODEL_RUNNER=reference

# --- Gold tier only ----------------------------------------------------------
# Proving defaults to circuits/prove.py under $PYTHON. Set this to put proving behind a queue
# or a bigger machine: it is invoked with the same JSON job on argv and must print either
# {"proof": "0x…"} or bare hex on stdout.
# EZKL_PROVER_CMD=./prove.sh
#
# Overrides the prover entirely, emitting an empty proof with correct public instances. Only
# valid against MockEzklVerifier; a real verifier rejects it, which is the honest outcome.
# ALLOW_DEV_PROOF=false

# --- watchtower --------------------------------------------------------------
# WATCHTOWER_KEY=

# --- consumer / challenger (local demo) --------------------------------------
# CONSUMER_KEY=
# CHALLENGER_KEY=

# --- arena -------------------------------------------------------------------
# The first-party consumer: orders work from every registered agent on a schedule and settles
# it against what the allocation actually returned. Needs CONSUMER_KEY to order and settle, and
# PUBLISHER_KEY to sign the readings — on a local chain the seed manifest supplies the latter.
# See docs/arena.md. Run `node src/index.js arena status` first: it shows what would be ordered
# and why each skipped agent was skipped, without spending anything.
# PUBLISHER_KEY=
#
# Exactly `circuits/spec.json.feeds` assets, in a fixed order. The order is part of what the
# model sees. Readings are NOT prices — each one is the asset rebased against its own price
# ARENA_LOOKBACK_HOURS ago, 100.00 meaning unchanged, because the circuit's domain stops at
# 3000.00 and because a model that compares raw tickers picks the expensive one every time.
# ARENA_ASSETS=BTC/USD,ETH/USD,SOL/USD
# ARENA_LOOKBACK_HOURS=24
#
# How long the allocation is held before it is graded. Must sit strictly between the router's
# challenge window and its settlement window; both are read from the chain and checked at
# startup. Too short and no honest allocation ever breaches anyone's declared loss tolerance,
# every quality lands at the cap, and the leaderboard converges on one number.
# ARENA_HOLD_HOURS=24
#
# ARENA_DELIVER_WINDOW_SEC=900
# ARENA_NOTIONAL_BPS=2500        per-job size, as a fraction of the agent's own credit line
# ARENA_COOLDOWN_SEC=3600        minimum gap between two jobs for the same agent
# ARENA_ORDER_INTERVAL_MS=300000
# ARENA_SETTLE_INTERVAL_MS=300000
#
# Hard ceiling on fees, in whole bond-token units. Checked before ordering rather than
# discovered by a revert: on any network where the bond token is real there is no mint to call.
# ARENA_FEE_BUDGET=
#
# Where AgentRegistered replay starts. Falls back to START_BLOCK, then to a short lookback.
# ARENA_FROM_BLOCK=
# ARENA_LOG_WINDOW=9000
#
# `coinbase` (public, no key) or `fixture:./prices.json` for an offline dry run.
# ARENA_PRICE_SOURCE=coinbase
#
# Where a remote agent can fetch the bundle. Without it the Arena emits a bare name, which only
# resolves for an agent sharing this filesystem.
# ARENA_BUNDLE_BASE_URL=https://arena.example.com/bundles
# ARENA_LEDGER=./.arena/ledger.json

# --- tuning ------------------------------------------------------------------
POLL_INTERVAL_MS=5000
CONFIRMATIONS=1
# START_BLOCK=
# BUNDLE_DIR=./.bundles

# An inputURI comes from whoever made the request, and is fetched from inside this machine's
# network before anything about it has been verified. Private, loopback and link-local addresses
# are refused by default — 169.254.169.254 is the cloud metadata endpoint that hands out
# credentials. Turn this on only to serve bundles from a host on your own network.
# ALLOW_PRIVATE_INPUT_URI=true
