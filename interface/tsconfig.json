{
  "compilerOptions": {
    // ES2020 is a floor, not a preference: bigint literals need it, and every capital amount in
    // this interface is a bigint. See lib/token.ts.
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      // Generated by contracts/scripts/export-abi.js and imported, never copied. See the
      // externalDir note in next.config.js for why this crosses the project boundary.
      "@abi": [
        "../contracts/abi/index.ts"
      ],
      "@abi/*": [
        "../contracts/abi/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-check/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
