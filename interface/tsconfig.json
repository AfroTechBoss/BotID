{
  "compilerOptions": {
    // ES2020 is a floor, not a preference: bigint literals need it, and every capital amount in
    // this interface is a bigint. See lib/token.ts.
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      // Generated by contracts/scripts/export-abi.js and imported, never copied. See the
      // externalDir note in next.config.js for why this crosses the project boundary.
      "@abi": [
        "../contracts/abi/index.ts"
      ],
      "@abi/*": [
        "../contracts/abi/*"
      ],
      // @neondatabase/serverless 1.1.0 ships index.d.ts and then does not point at it: its
      // package.json has no "types" field and an "exports" map with only "require" and "import"
      // conditions, so under moduleResolution "bundler" TypeScript refuses to look at a declaration
      // file sitting beside the module it declares. The import resolved to `any`, which took
      // lib/db.ts and every `rows.map` in app/api/alerts with it — two errors whose cause is one
      // missing line in somebody else's manifest.
      //
      // This steers type resolution only; the bundler still resolves the real module through
      // "exports" as before. Worth removing when neon publishes a "types" condition.
      "@neondatabase/serverless": [
        "./node_modules/@neondatabase/serverless/index.d.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-check/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
