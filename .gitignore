node_modules/
package-lock.json
out/
artifacts/
cache/
.env
.env.*
!.env.example
**/deployments/localhost-*.json
# Where execute-once.js remembers how far it got. Run progress, not a deployment record — one
# machine's half-finished errand, and committing it would hand the next clone a requestId that
# belongs to somebody else's chain.
**/deployments/execute-once-*.json
relayer/.bundles/

# Circuit build products. The proving key alone is ~150MB and the SRS is a download, so the
# repo carries the sources that regenerate them (spec.json, export_onnx.py, pipeline.py) rather
# than the products themselves. Verifier.sol is checked in as an exception — it is the artifact
# that actually gets deployed, and it should be reviewable in a diff.
circuits/build/*
!circuits/build/Verifier.sol

# Hardhat will not import across the project boundary, so hardhat.config.js keeps a copy of the
# verifier inside the sources tree and refreshes it on every command. Ignored so there is one
# reviewable version — the one above, beside the circuit that generated it.
contracts/src/verifiers/Halo2Verifier.sol
circuits/.venv/
__pycache__/

# Editors and OS.
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Claude Code's per-user state. launch.json is the exception: it is the dev-server definition
# every contributor needs, and it describes the project rather than the person running it.
.claude/*
!.claude/launch.json

# Working documents. `*.local.md` is scratch space for briefs and design notes that belong to
# whoever is holding the work, not to the protocol repo's history.
*.local.md
