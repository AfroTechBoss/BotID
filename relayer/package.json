{
  "name": "@botid/agent",
  "version": "0.1.0",
  "description": "Run a BotID agent, watchtower or consumer client — the reference implementation, as a library and a CLI",
  "license": "BUSL-1.1",
  "keywords": [
    "botid",
    "agent",
    "reputation",
    "verifiable-execution",
    "ethereum"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "src/sdk.js",
  "exports": {
    ".": "./src/sdk.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "bin": {
    "botid": "src/index.js"
  },
  "scripts": {
    "agent": "node src/index.js agent",
    "watchtower": "node src/index.js watchtower",
    "consumer": "node src/index.js consumer",
    "arena": "node src/index.js arena",
    "test": "node --test test/arena.test.js"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
